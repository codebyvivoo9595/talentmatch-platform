{
  "ConnectionStrings": {
    "TalentMatchDbConnection": "Server=.;Database=TalentMatchDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Key": "THIS_IS_SUPER_SECRET_CHANGE_LATER",
    "Issuer": "TalentMatch.Api",
    "Audience": "TalentMatch.Ui",
    "ExpiryMinutes": 60
  },

  "AISettings": {
    "Model": "mistralai/mistral-7b-instruct",
    "Endpoint": "https://openrouter.ai/api/v1/chat/completions"
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 30
      },
      {
        "Endpoint": "POST:/api/v1/analyze/guest",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "GET:/api/v1/analyze/guest/status",
        "Period": "1m",
        "Limit": 20
      }
    ]
  },

  "IpRateLimitPolicies": {
    "IpRules": []
  },

  "AllowedHosts": "*"
}
